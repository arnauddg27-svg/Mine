# Copy to .env and `set -a; source .env; set +a` (or export each line).
PEXELS_API_KEY=            # free at https://www.pexels.com/api/  (optional: falls back to gradients)
ANTHROPIC_API_KEY=         # recommended for clip mode (picks the moments); also enables quote scripts
# MOTIVATE_PRIVACY=private # override youtube.privacy without editing config.yaml
# MOTIVATE_VOICE=en-GB-RyanNeural
